<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Pinpoint.Views"
       x:Class="Pinpoint.Views.ShellPage"
       FlyoutBehavior="Disabled"
       Title="Pinpoint">

    <TabBar>
        <ShellContent Title="Map"     ContentTemplate="{DataTemplate views:MapPage}"     Icon="tab_map.png" />
        <ShellContent Title="Devices" ContentTemplate="{DataTemplate views:DevicesPage}" Icon="tab_devices.png" />
        <ShellContent Title="People"  ContentTemplate="{DataTemplate views:PeoplePage}"  Icon="tab_people.png" />
        <ShellContent Title="Alerts"  ContentTemplate="{DataTemplate views:AlertsPage}"  Icon="tab_bell.png" />
    </TabBar>
</Shell>
