<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Pinpoint.ViewModels"
             x:Class="Pinpoint.Views.Auth.SignUpPage"
             x:DataType="vm:AuthViewModel"
             BackgroundColor="{StaticResource Surface1}"
             Shell.NavBarIsVisible="False">

    <Grid Padding="24,64,24,24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label Text="Create account" Style="{StaticResource HeadlineLabel}" FontSize="30"/>
            <Label Text="One account, shared with the people you trust." Style="{StaticResource MutedLabel}"/>
        </VerticalStackLayout>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="14">
                <Border Style="{StaticResource Pill}" Padding="14,10">
                    <Entry Placeholder="Your name" Text="{Binding Name}"/>
                </Border>
                <Border Style="{StaticResource Pill}" Padding="14,10">
                    <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email"/>
                </Border>
                <Border Style="{StaticResource Pill}" Padding="14,10">
                    <Entry Placeholder="Password (6+ characters)" Text="{Binding Password}" IsPassword="True"/>
                </Border>
                <Label Text="{Binding ErrorText}" TextColor="#FF8A87" FontSize="12"
                       IsVisible="{Binding ErrorText, Converter={StaticResource NotEmpty}}"/>
                <Button Text="Create account" Command="{Binding SignUpCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            </VerticalStackLayout>
        </Border>

        <VerticalStackLayout Grid.Row="3" Spacing="10">
            <Label Text="Already have an account?" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center"/>
            <Button Text="Sign in" Style="{StaticResource GhostButton}" Command="{Binding GoToSignInCommand}"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
