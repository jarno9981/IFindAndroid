<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:conv="clr-namespace:Pinpoint.Converters">

    <conv:BoolToShareTextConverter x:Key="BoolToShareText" />
    <conv:BoolToShareColorConverter x:Key="BoolToShareColor" />
    <conv:BatteryToColorConverter x:Key="BatteryToColor" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:NotEmptyConverter x:Key="NotEmpty" />
    <conv:UnreadDotOpacityConverter x:Key="UnreadDotOpacity" />

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource Surface1}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="HeadlineLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceStrong}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceStrong}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="MutedLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Surface3}" />
        <Setter Property="BorderColor" Value="{StaticResource Outline}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource Outline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource Surface2}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="18" />
        </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource Outline}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource Surface3}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="999" />
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource OnSurface}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource OnSurfaceMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Surface1}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource OnSurface}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource OnSurfaceStrong}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Surface2}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource OnSurface}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Primary}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource OnSurfaceMuted}" />
    </Style>

</ResourceDictionary>
